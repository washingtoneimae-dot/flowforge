{
  "name": "flowforge",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source workflow automation platform (n8n/Zapier-style)",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "start": "pnpm --filter @flowforge/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --no-file-parallelism"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
